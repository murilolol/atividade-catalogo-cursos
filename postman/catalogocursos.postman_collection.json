    {
      "name": "3. Listagem por instrutor",
      "item": [
        {
          "name": "Cursos do instrutor ordenados por título (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/instrutores/{{instrutorId}}/cursos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "instrutores",
                "{{instrutorId}}",
                "cursos"
              ]
            }
