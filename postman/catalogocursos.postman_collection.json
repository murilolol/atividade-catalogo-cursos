              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
                  "const cursos = pm.response.json();",
                  "pm.test(\"Somente os cursos do instrutor, em ordem alfabética\", () => {",
                  "    pm.expect(cursos.map(c => c.titulo)).to.eql([\"APIs REST com Spring Boot\", \"Java orientado a objetos\"]);",
                  "});",
                  "pm.test(\"Itens sem dados do instrutor (sem recursão)\", () => {",
                  "    cursos.forEach(c => pm.expect(c).to.have.all.keys(\"id\", \"titulo\", \"cargaHoraria\", \"nivel\"));",
                  "});"
                ]
              }
            }
          ]
