          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 409 Conflict\", () => pm.response.to.have.status(409));",
                  "const erro = pm.response.json();",
                  "pm.test(\"Erro no formato { status, message, path }\", () => {",
                  "    pm.expect(erro.status).to.eql(409);",
                  "    pm.expect(erro.message).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(erro.path).to.be.a(\"string\");",
                  "});",
                  "pm.test(\"Path do erro\", () => pm.expect(erro.path).to.eql(\"/api/instrutores\"));"
                ]
              }
            }
          ]
        },
