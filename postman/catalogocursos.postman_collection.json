              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Instrutor correto\", () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"instrutorId\"))));"
                ]
              }
            }
          ]
        },
        {
