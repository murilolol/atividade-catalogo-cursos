{
  "info": {
    "name": "Catálogo Independente de Cursos",
    "description": "Fluxo completo da API do catálogo de cursos: cadastro de instrutores e cursos, consulta, listagem ordenada por instrutor e cenários de erro 400, 404 e 409. Reexecutável: cada execução gera um email novo. Rode a coleção inteira na ordem (Collection Runner ou Newman).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Instrutores",
      "item": [
        {
          "name": "Cadastrar instrutor (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/instrutores",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "instrutores"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Marina Costa\",\n  \"email\": \"{{emailInstrutor}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"emailInstrutor\", `marina.${Date.now()}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201 Created\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Header Location aponta para o recurso criado\", () => {",
                  "    pm.expect(pm.response.headers.get(\"Location\")).to.match(new RegExp(\"/api/instrutores/\" + pm.response.json().id + \"$\"));",
                  "});",
                  "const instrutor = pm.response.json();",
                  "pm.test(\"Resposta sem a coleção de cursos\", () => {",
                  "    pm.expect(instrutor).to.have.all.keys(\"id\", \"nome\", \"email\");",
                  "    pm.expect(instrutor.nome).to.eql(\"Marina Costa\");",
                  "});",
                  "pm.collectionVariables.set(\"instrutorId\", instrutor.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Cadastrar segundo instrutor (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/instrutores",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "instrutores"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Paulo Lima\",\n  \"email\": \"paulo.{{$timestamp}}{{$randomInt}}@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201 Created\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"outroInstrutorId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar instrutor (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/instrutores/{{instrutorId}}",
              "host": [
                "{{baseUrl}}"
